# ClipForge backend configuration (TRD §37). Copy to `.env` and adjust.
# Every value has a safe local default; only JWT_SECRET is mandatory in production.

# ---- application -------------------------------------------------------------
APP_ENV=development                 # development | test | production
DEPLOYMENT_MODE=local               # local (private, single machine) | cloud (multi-user SaaS)
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000  # comma separated
PUBLIC_BASE_URL=                    # absolute base for signed links; relative when empty
TRUST_PROXY_HEADERS=false
METRICS_TOKEN=                      # protect /metrics with a bearer token

# ---- database / queue --------------------------------------------------------
DATABASE_URL=                       # empty -> sqlite:///$STORAGE_ROOT/clipforge.db (WAL). Cloud: postgresql+psycopg://user:pass@host/db
AUTO_MIGRATE=true                   # run Alembic migrations on start-up
REDIS_URL=                          # optional: instant worker wake-up (DB queue stays the source of truth)

# ---- storage -----------------------------------------------------------------
STORAGE_BACKEND=local               # local | s3
STORAGE_ROOT=./data                 # uploads/ work/ outputs/ thumbnails/ transcripts/ logs/
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=3600

# ---- upload limits -----------------------------------------------------------
MAX_UPLOAD_BYTES=2147483648         # 2 GB
MAX_VIDEO_SECONDS=10800             # 3 hours
ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.webm,.m4v
UPLOAD_CHUNK_MAX_BYTES=67108864

# ---- clip generation ---------------------------------------------------------
DEFAULT_CLIPS_PER_JOB=5
MAX_CLIPS_PER_JOB=20
MIN_CLIP_SECONDS=10
TARGET_MIN_SECONDS=20
TARGET_MAX_SECONDS=60
MAX_CLIP_SECONDS=90

# ---- worker ------------------------------------------------------------------
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=120
MAX_CONCURRENT_FFMPEG=2
MAX_CONCURRENT_TRANSCRIPTIONS=1
MAX_JOB_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=30
MIN_FREE_DISK_BYTES=2147483648      # jobs stay QUEUED below this
MIN_FREE_RAM_BYTES=536870912

# ---- local AI ----------------------------------------------------------------
TRANSCRIPTION_PROVIDER=faster_whisper   # faster_whisper | fake (tests)
WHISPER_MODEL=auto                  # auto | large-v3 | medium | small | base (falls back automatically)
WHISPER_DEVICE=auto                 # auto | cuda | cpu
WHISPER_COMPUTE_TYPE=auto
WHISPER_MODEL_DIR=                  # cache dir for model weights
WHISPER_LANGUAGE=                   # empty = auto-detect
WARMUP_MODELS=false
LLM_PROVIDER=heuristic              # heuristic | ollama | transformers | openai_compatible | none
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
ALLOW_REMOTE_PROVIDERS=false        # nothing leaves the machine unless explicitly enabled
REMOTE_LLM_BASE_URL=
REMOTE_LLM_API_KEY=
EMBEDDINGS_PROVIDER=lexical         # lexical | sentence_transformers
VISION_PROVIDER=auto                # auto | opencv | ffmpeg | none
VISION_SAMPLE_FPS=2

# ---- media -------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SECONDS=3600
CAPTION_FONTS_DIR=

# ---- retention (privacy-first defaults) -------------------------------------
RETENTION_HOURS=24                  # source video kept after completion
OUTPUT_RETENTION_HOURS=168          # exports kept 7 days
FAILED_SOURCE_RETENTION_HOURS=72
CLEANUP_INTERVAL_SECONDS=600

# ---- auth / security ---------------------------------------------------------
AUTH_ENABLED=true                   # local mode may disable (single implicit user); always on in cloud
ALLOW_REGISTRATION=true
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=336
SESSION_COOKIE_SECURE=false         # true behind HTTPS
SESSION_COOKIE_SAMESITE=lax
ADMIN_EMAILS=                       # comma separated
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_HOUR=60

# ---- quotas / billing --------------------------------------------------------
DEFAULT_PLAN=                       # empty -> unlimited (local) / free (cloud); plans in config/plans.yaml
FREE_DAILY_MINUTES=
BILLING_PROVIDER=none
