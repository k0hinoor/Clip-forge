# Copy to .env (or just set these in your shell) to override CLIPFORGE defaults.
# Everything is optional - the app works out of the box on Windows, macOS and Linux.

# Where projects, caches, logs and exports live. Default: <repo>/data
# CLIPFORGE_DATA_DIR=D:\ClipForge\data

# Web server
# CLIPFORGE_HOST=127.0.0.1
# CLIPFORGE_PORT=8317
# CLIPFORGE_OPEN_BROWSER=true

# Run the render worker inside the web process (false = use `python -m clipforge worker`)
# CLIPFORGE_EMBED_WORKER=true

# Logging
# CLIPFORGE_LOG_LEVEL=INFO

# Prefer a system ffmpeg build over the bundled one
# CLIPFORGE_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# CLIPFORGE_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# Hugging Face mirror (e.g. hf-mirror.com) if huggingface.co is blocked on your network
# HF_ENDPOINT=https://hf-mirror.com

# Tests
# CLIPFORGE_TEST_MEDIA=D:\ClipForge\fixtures\source.mp4
# CLIPFORGE_KEEP_TEST_DATA=1
